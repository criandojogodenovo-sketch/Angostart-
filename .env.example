# AngoStart — exemplo de variáveis de ambiente
# Copiar para .env.local (desenvolvimento) ou definir na Vercel
# (Settings → Environment Variables) — NUNCA commitar chaves reais.

# ── Base de dados (Neon PostgreSQL) — OBRIGATÓRIA ──
DATABASE_URL=postgres://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Override opcional (tem prioridade sobre DATABASE_URL)
NEON_DATABASE_URL=

# ── Segurança ──
JWT_SECRET=trocar-por-um-segredo-longo
CRON_SECRET=segredo-para-proteger-os-crons

# ── IA multi-provider (todos OPCIONAIS — a IA ativa-se com ≥1 chave; com 2+ há redundância) ──
# Cadeia de fallback: bai → openrouter → gemini → groq → cerebras → sambanova
# 0. B.AI        — https://b.ai (gateway unificado, OpenAI-compat — PRINCIPAL)
# 1. OpenRouter  — https://openrouter.ai/keys        (free: 50 req/dia; 1000/dia com ≥10 créditos)
# 2. Gemini      — https://aistudio.google.com/apikey (OpenAI-compat; multimodal)
# 3. Groq        — https://console.groq.com/keys      (~14.400 req/dia free)
# 4. Cerebras    — https://cloud.cerebras.ai          (free trial; só texto)
# 5. SambaNova   — https://cloud.sambanova.ai         (só texto)
B_AI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
# Overrides opcionais de modelos (os defaults seguem o catálogo free atual):
# B_AI_MODEL_CHAT=glm-5.3-flash
# B_AI_MODEL_VISION=deepseek-v4-flash-vision-exp
# OPENROUTER_MODEL_TEXT=z-ai/glm-5.2:free
# OPENROUTER_MODEL_VISION=google/gemma-4-31b-it:free
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL_CHAT=llama-3.1-8b-instant
# GROQ_MODEL_VISION=meta-llama/llama-4-scout-17b-16e-instruct
# CEREBRAS_MODEL=llama-3.3-70b
# SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

# ── Email transacional (Brevo) ──
BREVO_API_KEY=
EMAIL_FROM=AngoStart <geral@angostart.ao>

# ── Uploads (Vercel Blob — KYC/comprovativos privados) ──
BLOB_READ_WRITE_TOKEN=

# ── Push notifications (Web Push/VAPID) ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:geral@angostart.ao

# ── Pagamentos (Momenu/KWiK sandbox) ──
MOMENU_API_KEY=
MOMENU_SANDBOX=true

# ── App ──
NEXT_PUBLIC_APP_URL=https://angostart.ao
ADMIN_EMAIL=geral@angostart.ao

# ── Comissões e limites da carteira (Kz) — opcionais, com defaults no código ──
# AFFILIATE_COMMISSION_PERCENT=
# COMMISSION_PRODUCT=
# COMMISSION_SERVICE_DOMICILIO=
# COMMISSION_FREELANCER=
# MIN_DEPOSIT_AMOUNT=
# MAX_DEPOSIT_AMOUNT=
# MAX_DAILY_DEPOSIT=
# MIN_WITHDRAW_AMOUNT=
# MAX_WITHDRAW_AMOUNT=
# MAX_DAILY_WITHDRAW=
